
package com.voicerecoverypro.app;

import android.app.Activity;
import android.os.Bundle;
import android.content.Intent;
import android.net.Uri;
import android.graphics.Color;
import android.view.View;
import android.view.Gravity;
import android.widget.*;
import android.media.MediaPlayer;

import androidx.documentfile.provider.DocumentFile;

import com.google.android.gms.ads.AdRequest;
import com.google.android.gms.ads.AdSize;
import com.google.android.gms.ads.AdView;
import com.google.android.gms.ads.MobileAds;

import java.io.InputStream;
import java.io.OutputStream;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;
import java.util.Locale;

public class MainActivity extends Activity {

    private static final int PICK_FOLDER = 101;
    private static final int SAVE_FILE = 102;

    private LinearLayout root;
    private LinearLayout fileList;
    private TextView status;
    private TextView selectedInfo;
    private DocumentFile selectedFile;
    private MediaPlayer player;
    private AdView adView;

    private final List<DocumentFile> audioFiles = new ArrayList<>();

    private final String[] extensions = {
        ".m4a", ".mp3", ".wav", ".amr", ".aac",
        ".ogg", ".opus", ".3gp", ".flac", ".wma"
    };

    @Override
    public void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(20, 18, 20, 10);
        root.setBackgroundColor(Color.WHITE);

        ScrollView scroll = new ScrollView(this);
        LinearLayout content = new LinearLayout(this);
        content.setOrientation(LinearLayout.VERTICAL);
        scroll.addView(content);

        TextView title = new TextView(this);
        title.setText("Voice Recovery Pro");
        title.setTextSize(26);
        title.setTextColor(Color.rgb(20, 70, 130));
        title.setGravity(Gravity.CENTER);
        title.setPadding(0, 12, 0, 8);
        content.addView(title);

        TextView intro = new TextView(this);
        intro.setText(
            "Find audio recordings in folders you can access. " +
            "Preview files and save copies."
        );
        intro.setTextSize(15);
        intro.setTextColor(Color.DKGRAY);
        intro.setPadding(0, 6, 0, 14);
        content.addView(intro);

        Button chooseButton = new Button(this);
        chooseButton.setText("Choose Recordings Folder");
        content.addView(chooseButton);
        chooseButton.setOnClickListener(v -> chooseFolder());

        status = new TextView(this);
        status.setText("Choose a folder to begin scanning.");
        status.setTextSize(14);
        status.setTextColor(Color.BLACK);
        status.setPadding(0, 14, 0, 12);
        content.addView(status);

        selectedInfo = new TextView(this);
        selectedInfo.setText("No recording selected.");
        selectedInfo.setTextColor(Color.DKGRAY);
        selectedInfo.setPadding(0, 4, 0, 8);
        content.addView(selectedInfo);

        Button previewButton = new Button(this);
        previewButton.setText("Preview Selected Recording");
        content.addView(previewButton);
        previewButton.setOnClickListener(v -> previewSelected());

        Button stopButton = new Button(this);
        stopButton.setText("Stop Playback");
        content.addView(stopButton);
        stopButton.setOnClickListener(v -> stopPlayback());

        Button saveButton = new Button(this);
        saveButton.setText("Save Copy of Selected Recording");
        content.addView(saveButton);
        saveButton.setOnClickListener(v -> saveSelected());

        TextView note = new TextView(this);
        note.setText(
            "\nImportant limitation\n" +
            "This app scans audio files that still exist in folders " +
            "you grant access to. It cannot guarantee recovery of " +
            "permanently deleted files, especially from protected " +
            "internal storage."
        );
        note.setTextSize(13);
        note.setTextColor(Color.GRAY);
        note.setPadding(0, 16, 0, 16);
        content.addView(note);

        fileList = new LinearLayout(this);
        fileList.setOrientation(LinearLayout.VERTICAL);
        content.addView(fileList);

        root.addView(scroll, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, 0, 1
        ));

        setContentView(root);

        MobileAds.initialize(this, initializationStatus -> {
            runOnUiThread(this::showTestBanner);
        });
    }

    private void chooseFolder() {
        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
        intent.addFlags(
            Intent.FLAG_GRANT_READ_URI_PERMISSION |
            Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION
        );
        startActivityForResult(intent, PICK_FOLDER);
    }

    @Override
    protected void onActivityResult(
        int requestCode, int resultCode, Intent data
    ) {
        super.onActivityResult(requestCode, resultCode, data);

        if (resultCode != RESULT_OK || data == null) {
            return;
        }

        if (requestCode == PICK_FOLDER) {
            Uri uri = data.getData();
            if (uri == null) return;

            try {
                getContentResolver().takePersistableUriPermission(
                    uri, Intent.FLAG_GRANT_READ_URI_PERMISSION
                );
            } catch (SecurityException ignored) {
            }

            DocumentFile folder = DocumentFile.fromTreeUri(this, uri);
            if (folder != null) {
                scanFolder(folder);
            }
        } else if (requestCode == SAVE_FILE && selectedFile != null) {
            Uri destination = data.getData();
            if (destination != null) {
                copyFile(selectedFile, destination);
            }
        }
    }

    private boolean isAudio(DocumentFile file) {
        String name = file.getName();
        if (name == null) return false;

        name = name.toLowerCase(Locale.ROOT);
        for (String extension : extensions) {
            if (name.endsWith(extension)) return true;
        }
        return false;
    }

    private void scanFolder(DocumentFile folder) {
        stopPlayback();
        audioFiles.clear();
        fileList.removeAllViews();
        status.setText("Scanning folder...");

        scanRecursively(folder, 0);

        status.setText(
            "Scan complete. Audio files found: " + audioFiles.size()
        );

        if (audioFiles.isEmpty()) {
            TextView empty = new TextView(this);
            empty.setText(
                "No supported audio files found in this accessible folder."
            );
            empty.setPadding(0, 10, 0, 10);
            fileList.addView(empty);
            return;
        }

        for (int i = 0; i < audioFiles.size(); i++) {
            final DocumentFile file = audioFiles.get(i);
            Button item = new Button(this);
            item.setText(file.getName());
            item.setAllCaps(false);
            fileList.addView(item);

            item.setOnClickListener(v -> {
                selectedFile = file;
                selectedInfo.setText("Selected: " + file.getName());
                Toast.makeText(
                    this, "Recording selected", Toast.LENGTH_SHORT
                ).show();
            });
        }
    }

    private void scanRecursively(DocumentFile folder, int depth) {
        if (depth > 12) return;

        DocumentFile[] children = folder.listFiles();

        for (DocumentFile child : children) {
            if (child.isDirectory()) {
                scanRecursively(child, depth + 1);
            } else if (child.isFile() && isAudio(child)) {
                audioFiles.add(child);
            }
        }
    }

    private void previewSelected() {
        if (selectedFile == null) {
            Toast.makeText(
                this, "Select a recording first", Toast.LENGTH_SHORT
            ).show();
            return;
        }

        stopPlayback();

        try {
            player = new MediaPlayer();
            player.setDataSource(
                this, selectedFile.getUri()
            );
            player.setOnPreparedListener(mp -> {
                mp.start();
                Toast.makeText(
                    this, "Playing recording", Toast.LENGTH_SHORT
                ).show();
            });
            player.setOnCompletionListener(mp -> stopPlayback());
            player.setOnErrorListener((mp, what, extra) -> {
                stopPlayback();
                Toast.makeText(
                    this, "This audio file could not be played.",
                    Toast.LENGTH_LONG
                ).show();
                return true;
            });
            player.prepareAsync();
        } catch (IOException | IllegalArgumentException e) {
            stopPlayback();
            Toast.makeText(
                this, "Unable to open this recording.",
                Toast.LENGTH_LONG
            ).show();
        }
    }

    private void stopPlayback() {
        if (player != null) {
            try {
                if (player.isPlaying()) player.stop();
            } catch (IllegalStateException ignored) {
            }
            player.release();
            player = null;
        }
    }

    private void saveSelected() {
        if (selectedFile == null) {
            Toast.makeText(
                this, "Select a recording first", Toast.LENGTH_SHORT
            ).show();
            return;
        }

        String name = selectedFile.getName();
        if (name == null || name.trim().isEmpty()) {
            name = "recovered-recording.m4a";
        }

        Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
        intent.addCategory(Intent.CATEGORY_OPENABLE);
        intent.setType("application/octet-stream");
        intent.putExtra(Intent.EXTRA_TITLE, name);
        startActivityForResult(intent, SAVE_FILE);
    }

    private void copyFile(DocumentFile source, Uri destination) {
        try (
            InputStream input = getContentResolver().openInputStream(
                source.getUri()
            );
            OutputStream output = getContentResolver().openOutputStream(
                destination
            )
        ) {
            if (input == null || output == null) {
                throw new IOException("Unable to open file streams");
            }

            byte[] buffer = new byte[8192];
            int count;

            while ((count = input.read(buffer)) != -1) {
                output.write(buffer, 0, count);
            }

            output.flush();

            Toast.makeText(
                this, "Recording copy saved successfully.",
                Toast.LENGTH_LONG
            ).show();

        } catch (IOException e) {
            Toast.makeText(
                this, "Could not save the recording copy.",
                Toast.LENGTH_LONG
            ).show();
        }
    }

    private void showTestBanner() {
        if (isFinishing()) return;

        adView = new AdView(this);
        adView.setAdSize(AdSize.BANNER);
        adView.setAdUnitId(
            "ca-app-pub-3940256099942544/6300978111"
        );

        root.addView(adView, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT
        ));

        adView.loadAd(new AdRequest.Builder().build());
    }

    @Override
    protected void onDestroy() {
        stopPlayback();

        if (adView != null) {
            adView.destroy();
        }

        super.onDestroy();
    }
}

